DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5434/copilot
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me
LOCAL_VAULT_MASTER_KEY=dev-local-vault-master-key-change-me-32bytes

EXECUTION_ENABLED=false

AI_ORCHESTRATOR_URL=http://localhost:8001

CORS_ORIGINS=["http://localhost:3000"]

# ── RAG / Knowledge Base ────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

CHUNK_SIZE=512
CHUNK_OVERLAP=50

RAG_INITIAL_TOP_K=20
RAG_FINAL_TOP_K=6

MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=["pdf","docx","txt","md","csv","html","ps1","sh"]

FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=./storage/documents
S3_BUCKET=
S3_REGION=

